# --- Stage 1: Builder ---
FROM python:3.11-slim as builder

WORKDIR /app

# Install build dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends gcc python3-dev && \
    rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
# CRITICAL: Install packages to the root user's local path.
RUN pip install --no-cache-dir --user -r requirements.txt

# --- Stage 2: Final Runtime ---
FROM python:3.11-slim

WORKDIR /app

# Install runtime dependencies (like curl)
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl && \
    rm -rf /var/lib/apt/lists/*

# Non-root user setup MUST come before copying the files to its home
RUN useradd --create-home --shell /bin/bash appuser

# FIX 1: Copy Python packages from builder's /root/.local to the
# **non-root user's home directory** (/home/appuser/.local).
COPY --from=builder /root/.local /home/appuser/.local

# FIX 2: Set the PATH to include the NEW user's binary directory.
ENV PATH=/home/appuser/.local/bin:$PATH

# Switch to the non-root user
USER appuser

# Copy application code (must be AFTER the user switch for permissions)
# This copies application files into /home/appuser/app
COPY . . 

# Environment Configuration
ENV PORT=8080
ENV PYTHONUNBUFFERED=1

# Health Check: ${PORT} is expanded correctly by the shell form CMD
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:${PORT}/health || exit 1

# Command: Runs a single Uvicorn process (shell form for variable expansion)
# Uvicorn should now be found at /home/appuser/.local/bin/uvicorn
CMD uvicorn main:app --host 0.0.0.0 --port ${PORT}
