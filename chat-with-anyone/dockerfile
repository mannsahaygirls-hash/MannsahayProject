# Use an official Python runtime
FROM python:3.11-slim

# Set the working directory
WORKDIR /app

# Copy and install requirements
# We install dependencies before copying the application code to optimize Docker caching
COPY requirements.txt .
RUN pip install --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt

# Copy the rest of the application code
COPY . .

# Expose the port (Cloud Run detects this automatically, but it's good practice)
ENV PORT 8080
EXPOSE 8080

# Use official Python image
FROM python:3.11-slim

# Working directory
WORKDIR /app

# Install dependencies
COPY requirements.txt .
RUN pip install --upgrade pip && pip install --no-cache-dir -r requirements.txt uvicorn[standard]

# Copy application
COPY . .

# Environment setup
ENV PORT=8080
EXPOSE 8080

# Use uvicorn directly — needed for WebSockets
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1", "--loop", "uvloop", "--timeout-keep-alive", "300"]

